# ============================================================================
# Commercial Banking AI Agent Service — Environment Variables
# Copy this file to .env and update values for your environment.
# ============================================================================

# --- Database (MySQL via SQLAlchemy) ---
# Connection string for the AI agent service database
AI_AGENT_DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@localhost:3306/banking_ai_agent_service

# --- Core Banking Service ---
# Base URL of the core-banking-service REST API
AI_AGENT_CORE_BANKING_BASE_URL=http://core-banking-service:8092

# --- OpenAI / LLM Settings ---
# OpenAI API key (leave empty to use rule-based fallbacks without LLM)
AI_AGENT_OPENAI_API_KEY=${OPENAI_API_KEY}
# Model to use for LLM calls
AI_AGENT_OPENAI_MODEL=gpt-4o-mini
# Temperature for LLM responses (lower = more deterministic)
AI_AGENT_OPENAI_TEMPERATURE=0.3

# --- Server ---
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8093
AI_AGENT_DEBUG=false

# --- Eureka Service Discovery (optional) ---
AI_AGENT_EUREKA_SERVER_URL=http://service-registry:8081/eureka
AI_AGENT_SERVICE_NAME=commercial-banking-ai-agent-service
