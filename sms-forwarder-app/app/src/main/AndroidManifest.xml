<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest for SMS Forwarder Application
     Declares permissions for SMS reading, internet access, and biometrics.
     Registers the SMS BroadcastReceiver and all Activity screens. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to receive incoming SMS messages in real-time -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Permission to read SMS message content -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Permission to access the internet for SMTP email sending -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permission to check network connectivity before sending emails -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Permission to use biometric hardware (fingerprint/face) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Permission to re-register SMS receiver after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Biometric hardware is optional - app falls back to PIN-only auth -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".SmsForwarderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SMSForwarder"
        tools:targetApi="34">

        <!-- Authentication gate - first screen shown on app launch -->
        <activity
            android:name=".ui.AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.SMSForwarder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main dashboard - displays log of forwarded messages -->
        <activity android:name=".ui.MainActivity" />

        <!-- Settings screen - configure email, SMTP, and forwarding preferences -->
        <activity android:name=".ui.SettingsActivity" />

        <!-- PIN setup/change screen - create or update the access PIN -->
        <activity android:name=".ui.SetupPinActivity" />

        <!-- SMS Broadcast Receiver - listens for incoming SMS at high priority -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Boot Receiver - ensures SMS forwarding resumes after device restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
