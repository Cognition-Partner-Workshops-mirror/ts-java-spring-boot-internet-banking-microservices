# Copy this file to .env and replace placeholder values before running docker-compose.
# Do NOT commit the .env file to version control.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_APP_USER_PASSWORD=change-me-app-password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Keycloak PostgreSQL
KC_DB_PASSWORD=change-me-kc-db-password
