# =============================================================================
# Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
#
#   cp .env.example .env
#   # Edit .env with your chosen passwords
#   docker-compose up -d
#
# Variables marked as REQUIRED will cause docker-compose to fail if not set.
# Variables with defaults (shown after :-) are optional.
# =============================================================================

# --- MySQL -------------------------------------------------------------------
# Root password for the MySQL instance (REQUIRED)
MYSQL_ROOT_PASSWORD=

# Application database user and password
MYSQL_APP_USER=javatodev_development
# Password for the application database user (REQUIRED)
MYSQL_APP_PASSWORD=

# --- Keycloak ----------------------------------------------------------------
# Keycloak admin console credentials
KEYCLOAK_ADMIN_USER=admin
# Keycloak admin password (REQUIRED)
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak backing PostgreSQL database credentials
KEYCLOAK_DB_USER=keycloak
# Keycloak database password (REQUIRED)
KEYCLOAK_DB_PASSWORD=
