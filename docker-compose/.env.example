# Docker Compose environment variables — copy to .env and fill in actual values
# DO NOT commit the .env file to source control

# MySQL root password for core banking database
MYSQL_ROOT_PASSWORD=change_me

# Keycloak database (PostgreSQL) password
KC_DB_PASSWORD=change_me
POSTGRES_PASSWORD=change_me

# Keycloak admin console password
KEYCLOAK_ADMIN_PASSWORD=change_me

# Jasypt encryption password for Spring Cloud Config encrypted properties
JASYPT_ENCRYPTOR_PASSWORD=change_me
